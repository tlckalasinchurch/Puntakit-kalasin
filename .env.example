[TEMPLATE]
# Runtime configuration. Never commit real values to Git.
#
# ---------------------------------------------------------------------------
# Database driver selection
# ---------------------------------------------------------------------------
# Explicit driver: neon | postgres | pglite
#   neon     -> Neon serverless HTTP driver (@neondatabase/serverless)
#   postgres -> postgres-js TCP pool (any PostgreSQL: self-hosted, Supabase, ...)
#   pglite   -> embedded PostgreSQL (local development only)
DATABASE_DRIVER=neon
DATABASE_URL=postgresql://...

# ---------------------------------------------------------------------------
# Local embedded PostgreSQL (PGlite) — NODE_ENV=production always refuses this
# ---------------------------------------------------------------------------
# USE_LOCAL_DB=true            # shortcut for DATABASE_DRIVER=pglite (dev only)
# PGLITE_DATA_DIR=./.db_data   # absolute or cwd-relative; default ./.db_data

# ---------------------------------------------------------------------------
# postgres-js connection options (DATABASE_DRIVER=postgres only)
# ---------------------------------------------------------------------------
# POSTGRES_MAX_CONNECTIONS=10
# POSTGRES_IDLE_TIMEOUT_SECONDS=20
# POSTGRES_CONNECT_TIMEOUT_SECONDS=10
# POSTGRES_SSL=require          # require | allow | prefer | verify-full | no-verify | disable

# ---------------------------------------------------------------------------
# Migrations
# ---------------------------------------------------------------------------
# PGlite always migrates on startup. Remote drivers only migrate when this is
# true (otherwise run `pnpm db:migrate` explicitly).
# DB_AUTO_MIGRATE=false

# ---------------------------------------------------------------------------
# Clerk authentication (https://clerk.com)
# ---------------------------------------------------------------------------
# Client key (public by design) — Vite requires the VITE_ prefix.
# Do not use NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY in this React/Vite app.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
# Server key (SECRET — server only, never exposed to the client).
CLERK_SECRET_KEY=sk_test_...
# Webhook signing secret from Clerk Dashboard > Webhooks.
# CLERK_WEBHOOK_SIGNING_SECRET=whsec_...

# Existing Manus storage integration (optional for local preview)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
